on post-fs-data
    mkdir /data/mdlog 0775 system system encryption=DeleteIfNecessary
    mkdir /data/ramdump 0775 shell system encryption=DeleteIfNecessary
    mkdir /data/debuglogger 0770 shell log encryption=DeleteIfNecessary

on post-fs-data && property:ro.vendor.mtklog_internal=1
    mkdir /data/log 0775 system log  encryption=DeleteIfNecessary

service emdlogger /system/system_ext/bin/emdlogger
    class main
    user shell
    group log system shell radio sdcard_rw inet sdcard_r media_rw

on property:vold.decrypt=trigger_restart_framework
    start emdlogger

on property:persist.vendor.em.dy.debug=1
    stop emdlogger

on property:ro.vendor.mtk_protocol1_rat_config=1
    stop emdlogger

on property:persist.vendor.mdlog.3G=1
    stop emdlogger
